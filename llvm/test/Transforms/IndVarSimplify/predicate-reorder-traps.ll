; CHECK-NEXT:    [[TMP6:%.*]] = icmp eq i128 [[TMP1]], [[UMIN1]]
; CHECK-NEXT:    [[TMP7:%.*]] = icmp eq i128 [[TMP3]], [[UMIN1]]
; CHECK-NEXT:    [[TMP8:%.*]] = zext i64 [[TMP4]] to i128
; CHECK-NEXT:    [[TMP9:%.*]] = icmp ne i128 [[TMP8]], [[UMIN1]]
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    br i1 [[TMP6]], label [[TRAP1:%.*]], label [[E2:%.*]]
; CHECK:       trap1:
; CHECK-NEXT:    call void @llvm.trap()
; CHECK-NEXT:    unreachable
; CHECK:       e2:
; CHECK-NEXT:    br i1 [[TMP7]], label [[TRAP2:%.*]], label [[LATCH:%.*]]
; CHECK:       trap2:
; CHECK-NEXT:    call void @llvm.trap()
; CHECK-NEXT:    unreachable
; CHECK:       latch:
; CHECK-NEXT:    br i1 [[TMP9]], label [[LOOP]], label [[EXIT_LOOPEXIT:%.*]]
; CHECK:       exit.loopexit:
; CHECK-NEXT:    br label [[EXIT]]
; CHECK:       exit:
; CHECK-NEXT:    ret void
;
entry:
  %z = icmp eq i64 %n, 0
  br i1 %z, label %exit, label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %inc, %latch ]
  %bad1 = icmp ugt i64 %i, %m
  br i1 %bad1, label %trap1, label %e2

trap1:
  call void @llvm.trap()
  unreachable

e2:
  %bad2 = icmp ugt i64 %i, %k
  br i1 %bad2, label %trap2, label %latch

trap2:
  call void @llvm.trap()
  unreachable

latch:
  %inc = add nuw nsw i64 %i, 1
  %c = icmp ult i64 %inc, %n
  br i1 %c, label %loop, label %exit

exit:
  ret void
}
