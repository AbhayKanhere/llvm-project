; ON-NEXT:  entry:
; ON-NEXT:    [[Z:%.*]] = icmp eq i64 [[N:%.*]], 0
; ON-NEXT:    br i1 [[Z]], label [[EXIT:%.*]], label [[LOOP_PREHEADER:%.*]]
; ON:       loop.preheader:
; ON-NEXT:    [[TMP0:%.*]] = zext i64 [[M:%.*]] to i128
; ON-NEXT:    [[TMP1:%.*]] = add nuw nsw i128 [[TMP0]], 1
; ON-NEXT:    [[TMP2:%.*]] = add i64 [[N]], -1
; ON-NEXT:    [[TMP3:%.*]] = zext i64 [[TMP2]] to i128
; ON-NEXT:    [[UMIN:%.*]] = call i128 @llvm.umin.i128(i128 [[TMP1]], i128 [[TMP3]])
