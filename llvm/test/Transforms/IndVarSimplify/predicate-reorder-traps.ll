; ON:       trap1:
; ON-NEXT:    call void @llvm.trap()
; ON-NEXT:    unreachable
; ON:       mid:
; ON-NEXT:    [[MUL:%.*]] = mul nuw i64 [[I]], 4
; ON-NEXT:    [[END:%.*]] = add nuw i64 [[MUL]], 4
; ON-NEXT:    [[LIMIT:%.*]] = mul nuw i64 [[N]], 4
; ON-NEXT:    [[OVF:%.*]] = icmp ugt i64 [[END]], [[LIMIT]]
; ON-NEXT:    br i1 [[OVF]], label [[TRAP2:%.*]], label [[LATCH]]
; ON:       trap2:
; ON-NEXT:    call void @llvm.trap()
; ON-NEXT:    unreachable
; ON:       latch:
; ON-NEXT:    [[PTR:%.*]] = getelementptr i8, ptr [[P:%.*]], i64 [[I]]
; ON-NEXT:    store i8 0, ptr [[PTR]], align 1
; ON-NEXT:    [[INC]] = add nuw nsw i64 [[I]], 1
; ON-NEXT:    [[C:%.*]] = icmp ult i64 [[INC]], [[N]]
; ON-NEXT:    br i1 [[C]], label [[LOOP]], label [[EXIT_LOOPEXIT:%.*]]
; ON:       exit.loopexit:
; ON-NEXT:    br label [[EXIT]]
; ON:       exit:
; ON-NEXT:    ret void
