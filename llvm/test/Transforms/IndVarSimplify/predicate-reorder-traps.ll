; OFF-NEXT:  entry:
; OFF-NEXT:    [[Z:%.*]] = icmp eq i64 [[N:%.*]], 0
; OFF-NEXT:    br i1 [[Z]], label [[EXIT:%.*]], label [[LOOP_PREHEADER:%.*]]
; OFF:       loop.preheader:
; OFF-NEXT:    br label [[LOOP:%.*]]
